{
  "nodes": [
    {
      "id": "file:game.py",
      "type": "file",
      "name": "game.py",
      "filePath": "game.py",
      "summary": "Core game engine for the Pacman AI projects: defines the Agent interface, direction constants, configurations, boolean grids, the game-state data packet, and the Game control loop that solicits actions from agents and applies rules.",
      "tags": [
        "game-engine",
        "simulation",
        "data-model",
        "core"
      ],
      "complexity": "complex",
      "languageNotes": "Uses `from util import *` star-imports, so utility helpers (TimeoutFunction, nearestPoint, raiseNotDefined) are resolved at module scope rather than through explicit imports."
    },
    {
      "id": "class:game.py:Agent",
      "type": "class",
      "name": "Agent",
      "filePath": "game.py",
      "lineRange": [
        35,
        51
      ],
      "summary": "Abstract base class every Pacman agent extends; stores the agent index and declares getAction, which raises until a subclass overrides it.",
      "tags": [
        "abstract-base",
        "agent",
        "interface"
      ],
      "complexity": "simple"
    },
    {
      "id": "class:game.py:Directions",
      "type": "class",
      "name": "Directions",
      "filePath": "game.py",
      "lineRange": [
        54,
        65
      ],
      "summary": "Namespace of movement constants (North, South, East, West, Stop) plus LEFT/RIGHT/REVERSE lookup tables used to rotate and invert directions.",
      "tags": [
        "constants",
        "direction",
        "lookup-table"
      ],
      "complexity": "simple"
    },
    {
      "id": "class:game.py:Configuration",
      "type": "class",
      "name": "Configuration",
      "filePath": "game.py",
      "lineRange": [
        68,
        117
      ],
      "summary": "Immutable-style (x, y) position plus travel direction with hashing and equality so configurations can key dictionaries, and generateSuccessor to translate along a movement vector.",
      "tags": [
        "data-model",
        "position",
        "state"
      ],
      "complexity": "simple"
    },
    {
      "id": "class:game.py:AgentState",
      "type": "class",
      "name": "AgentState",
      "filePath": "game.py",
      "lineRange": [
        120,
        165
      ],
      "summary": "Tracks one agent's configuration, pacman/ghost flag, scared timer and contest counters, with copy support for cloning game states.",
      "tags": [
        "data-model",
        "agent-state",
        "copying"
      ],
      "complexity": "simple"
    },
    {
      "id": "class:game.py:Grid",
      "type": "class",
      "name": "Grid",
      "filePath": "game.py",
      "lineRange": [
        168,
        290
      ],
      "summary": "Boolean 2D grid backed by a list of lists, indexed grid[x][y], offering copy/count/asList queries and bit-packing helpers used to serialize food and wall maps compactly.",
      "tags": [
        "data-structure",
        "grid",
        "bit-packing",
        "serialization"
      ],
      "complexity": "complex"
    },
    {
      "id": "class:game.py:Actions",
      "type": "class",
