    {
      "id": "file:pacman.py",
      "type": "file",
      "name": "pacman.py",
      "filePath": "pacman.py",
      "summary": "Main entry point and rules layer for Pacman: defines the agent-facing GameState, the classic win/lose rules, pacman and ghost movement rules, and the CLI that wires layouts, agents and displays into games.",
      "tags": [
        "entry-point",
        "game-rules",
        "cli",
        "game-state"
      ],
      "complexity": "complex",
      "languageNotes": "Agents are discovered dynamically at runtime by importing any *Agents.py module on PYTHONPATH and looking up the class by name, so agent files are not statically imported."
    },
    {
      "id": "class:pacman.py:GameState",
      "type": "class",
      "name": "GameState",
      "filePath": "pacman.py",
      "lineRange": [
        58,
        261
      ],
      "summary": "Agent-facing view of the game: accessors for food, capsules, walls, pacman and ghost states and score, plus generateSuccessor which copies the state, applies an action and resolves collisions.",
