      "filePath": "game.py",
      "lineRange": [
        305,
        405
      ],
      "summary": "Static helper collection that converts between direction names and movement vectors and enumerates legal moves and neighbors given a wall grid.",
      "tags": [
        "utility",
        "movement",
        "static-methods"
      ],
      "complexity": "moderate"
    },
    {
      "id": "class:game.py:GameStateData",
