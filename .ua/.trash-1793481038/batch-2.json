    {
      "id": "file:ghostAgents.py",
      "type": "file",
      "name": "ghostAgents.py",
      "filePath": "ghostAgents.py",
      "summary": "Defines the ghost agent policies used during multi-agent search: an abstract GhostAgent plus uniformly random and Pacman-seeking/fleeing DirectionalGhost implementations that expose action probability distributions.",
      "tags": ["agent-policy", "game-ai", "probability-distribution", "pacman", "search"],
      "complexity": "simple"
    },
    {
      "id": "class:ghostAgents.py:GhostAgent",
      "type": "class",
      "name": "GhostAgent",
      "filePath": "ghostAgents.py",
      "lineRange": [22, 35],
      "summary": "Abstract base ghost agent that samples an action from the distribution returned by getDistribution, falling back to STOP when no action is available.",
      "tags": ["abstract-base-class", "agent", "sampling", "game-ai"],
      "complexity": "simple"
    },
    {
      "id": "class:ghostAgents.py:RandomGhost",
      "type": "class",
      "name": "RandomGhost",
      "filePath": "ghostAgents.py",
      "lineRange": [38, 46],
      "summary": "Ghost policy that assigns equal probability to every legal action and returns the normalized uniform distribution.",
      "tags": ["agent-policy", "random", "probability-distribution"],
      "complexity": "simple"
    },
    {
      "id": "class:ghostAgents.py:DirectionalGhost",
      "type": "class",
      "name": "DirectionalGhost",
      "filePath": "ghostAgents.py",
      "lineRange": [49, 95],
      "summary": "Ghost policy that computes successor positions for each legal action and biases the distribution toward moves that minimize (attack) or maximize (scared flee) Manhattan distance to Pacman.",
      "tags": ["agent-policy", "heuristic", "probability-distribution", "game-ai"],
      "complexity": "moderate"
    },
    {
      "id": "file:multiAgents.py",
      "type": "file",
      "name": "multiAgents.py",
      "filePath": "multiAgents.py",
      "summary": "Student implementation file for the adversarial search project, containing the reflex agent, the shared multi-agent search base class, and the Minimax, Alpha-Beta, and Expectimax agent skeletons plus evaluation functions.",
      "tags": ["adversarial-search", "minimax", "expectimax", "evaluation-function", "assignment-stub"],
      "complexity": "moderate",
      "languageNotes": "Agent classes are selected at runtime by pacman.py via util.lookup, so class names must remain importable module-level symbols."
    },
    {
      "id": "class:multiAgents.py:ReflexAgent",
      "type": "class",
      "name": "ReflexAgent",
      "filePath": "multiAgents.py",
      "lineRange": [22, 81],
      "summary": "Reflex agent that scores every legal action with an evaluation function and randomly picks among the highest-scoring moves; the evaluation function is the student-editable part.",
      "tags": ["reflex-agent", "evaluation-function", "action-selection"],
      "complexity": "moderate"
    },
    {
